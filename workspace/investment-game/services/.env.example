PEPPER_PASS=your_pepper_ssh_password

AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-nano
AZURE_OPENAI_API_VERSION=2025-03-01-preview

# get HF_TOKEN from https://hf.co/settings/tokens after accepting conditions at:
# https://huggingface.co/pyannote/overlapped-speech-detection 
# and https://huggingface.co/pyannote/segmentation
HF_TOKEN=your_huggingface_token

ROBOT_IP=192.168.0.100
COMPUTER_IP=192.168.0.XXX

# Experiment configuration
ROBOT_CONTROL_TYPE=LLM  # LLM or ALG
TRUSTWORTHINESS=T       # T or U
PARTICIPANT_GAME_LIMIT=2
# PARTICIPANT_ID=P001   # Optional
GAME_ROUNDS=3

# Optional speech tuning

# Speech model
# STT_MODEL=base.en

# STT_FINALIZATION_TIMEOUT_SECONDS=3.5
# STT_FINALIZATION_GRACE_SECONDS=2.0
# STT_RECOVERY_COOLDOWN_SECONDS=0.6
# STT_RESET_ON_FINALIZATION_TIMEOUT=false
# SILENCE_LIMIT_FRAMES=55

# Minimum summed overlap duration in OSD output to count as true overlap
# OSD_MIN_OVERLAP_TOTAL_S=0.18

# Initial grace period after TTS starts before OSD can trigger barge-in
# OSD_CHECK_AFTER_ROBOT_START_S=0.10

# Disable denoise in OSD for lower CPU usage
# OSD_USE_DENOISE=false

# Temporal smoothing window for OSD boolean hits
# OSD_HIT_WINDOW_SIZE=3

# Number of OSD hits required within the smoothing window
# OSD_HITS_REQUIRED_IN_WINDOW=2

# Absolute residual-ratio threshold for fast overlap trigger
# OVERLAP_MIN_ABS_RESIDUAL_RATIO=0.08

# Baseline history size required before fast overlap can trigger
# OVERLAP_BASELINE_DELTA=0.015


# Optional Piper streaming settings
# PIPER_URL=http://piper:5000/stream
# PIPER_SPEAKER=androgynous
# PIPER_STREAM_READ_TIMEOUT_SECONDS=45

# Piper concurrency controls
# PIPER_MAX_CONCURRENT_SYNTHESIS=1
# PIPER_SYNTHESIS_SLOT_TIMEOUT_SECONDS=20
# PIPER_LOG_STDERR=false

# This is what controls the speech
# LENGTH_SCALE=0.72
# NOISE_SCALE=0.9
# NOISE_W_SCALE=0.8

# Pepper to speech callback timeout
# SPEECH_NOTIFY_TIMEOUT_SECONDS=1.2
