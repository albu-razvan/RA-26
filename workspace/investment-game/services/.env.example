PEPPER_PASS=your_pepper_ssh_password

AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-nano
AZURE_OPENAI_API_VERSION=2025-03-01-preview

# get HF_TOKEN from https://hf.co/settings/tokens after accepting conditions at:
# https://huggingface.co/pyannote/overlapped-speech-detection 
# and https://huggingface.co/pyannote/segmentation
HF_TOKEN=your_huggingface_token

ROBOT_IP=192.168.0.100
COMPUTER_IP=192.168.0.XXX

# Optional speech tuning
# STT_MODEL=base.en
# SILENCE_LIMIT_FRAMES=70
